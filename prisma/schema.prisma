generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  RT
  WARGA
}

model User {
  id          Int      @id @default(autoincrement())
  noTelepon   String?  @unique // Digunakan sebagai username login warga
  email       String?  @unique // Digunakan sebagai username login admin (RT, Sekretaris, Bendahara)
  name        String?
  role        Role     @default(WARGA)
  password    String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  warga       Warga?
}

model Warga {
  id              Int       @id @default(autoincrement())
  noRumah         String?   // Nomor/alamat rumah warga
  noKK            String    @unique
  kepalaKeluarga  String
  jumlahAnggota   Int       @default(1)
  noTelepon       String?
  statusRumah     String    @default("MILIK_SENDIRI") // MILIK_SENDIRI, SEWA, KONTRAK
  userId          Int       @unique
  user            User      @relation(fields: [userId], references: [id])
  peminjaman      Peminjaman[]
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model Barang {
  id          Int      @id @default(autoincrement())
  nama        String
  deskripsi   String?
  stok        Int      @default(0)
  fotoUrl     String?
  status      String   @default("TERSEDIA") // TERSEDIA, RUSAK, DIPINJAM
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  peminjaman  Peminjaman[]
}

enum StatusPeminjaman {
  PENDING
  DISETUJUI
  DITOLAK
  DIAMBIL
  SELESAI
}

enum KondisiBarang {
  BAIK
  RUSAK
}

model Peminjaman {
  id              Int               @id @default(autoincrement())
  wargaId         Int
  warga           Warga             @relation(fields: [wargaId], references: [id])
  barangId        Int
  barang          Barang            @relation(fields: [barangId], references: [id])
  tanggalMulai    DateTime
  tanggalSelesai  DateTime
  tujuan          String
  jumlah          Int               @default(1)
  status          StatusPeminjaman  @default(PENDING)
  alasanPenolakan String?
  kondisiKeluar   KondisiBarang?    // Kondisi saat barang diambil
  kondisiKembali  KondisiBarang?    // Kondisi saat barang dikembalikan
  buktiUrl        String?           // E-Receipt URL atau Bukti digital
  tandaTanganUrl  String?           // Signature RT
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  kerusakan       Kerusakan[]
}

enum StatusPembayaran {
  PENDING
  SUCCESS
  FAILED
}

model Kerusakan {
  id              Int           @id @default(autoincrement())
  peminjamanId    Int
  peminjaman      Peminjaman    @relation(fields: [peminjamanId], references: [id])
  deskripsi       String
  nominalDenda    Float
  statusPembayaran StatusPembayaran @default(PENDING)
  buktiUrl        String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}